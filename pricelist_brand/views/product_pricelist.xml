<odoo>
    <record id="product_pricelist_item_form_view" model="ir.ui.view">
        <field name="name">product.pricelist.item.form (in pricelist_brand)</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
        <field name="arch" type="xml">
            <field name="categ_id" position="before">
                <field
                    name="product_brand_id"
                    readonly="categ_id or product_tmpl_id or product_id"
                    options="{'no_create': True}"
                    placeholder="All brands"
                />
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="readonly" add="product_brand_id" separator=" or " />
            </field>
            <field name="product_tmpl_id" position="attributes">
                <attribute name="readonly" add="product_brand_id" separator=" or " />
            </field>
            <field name="product_id" position="attributes">
                <attribute name="readonly" add="product_brand_id" separator=" or " />
            </field>
        </field>
    </record>
</odoo>
