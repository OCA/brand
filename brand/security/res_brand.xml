<odoo>
    <record id="res_brand_access_all" model="ir.access">
        <field name="name">res.brand access all</field>
        <field name="group_id" ref="base.group_everyone" />
        <field name="model_id" ref="model_res_brand" />
        <field name="operation">r</field>
    </record>
    <record id="res_brand_access_manager" model="ir.access">
        <field name="name">res.brand manager access</field>
        <field name="model_id" ref="model_res_brand" />
        <field name="group_id" ref="base.group_system" />
        <field name="operation">crud</field>
    </record>
    <record id="res_brand_multi_company_rule" model="ir.access">
        <field name="name">Res Brand multi company rule</field>
        <field name="operation">crud</field>
        <field name="model_id" ref="model_res_brand" />
        <field name="domain">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
