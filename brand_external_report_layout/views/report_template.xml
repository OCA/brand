<odoo>
    <template id="brand_external_layout" inherit_id="web.external_layout">
        <xpath expr="//t[@t-if='not company']" position="after">
            <t
                t-if="not brand and o and 'brand_id' in o and o.brand_id.external_report_layout_id"
                t-set="brand"
                t-value="o.brand_id.sudo()"
            />
            <t t-if="brand" t-set="company" t-value="brand" />
            <t t-set="brand_id" t-value="brand.id if brand else False" />
        </xpath>
    </template>

    <template id="styles_brand_report">
        <t t-set="brand_styles">
            <t t-call="web.styles_company_report" company_ids="brand_ids" />
        </t>
        <t
            t-out="brand_styles.replace('.o_company_', '.o_brand_').replace('.o_color_company_', '.o_color_brand_')"
        />
    </template>

    <template id="external_layout_body" inherit_id="web.external_layout_body">
        <xpath expr="//div[contains(@t-attf-class, 'article')]" position="attributes">
            <attribute
                name="t-attf-class"
                remove="o_company_#{company.id}_layout"
                add="o_#{'brand' if brand_id else 'company'}_#{brand_id or company.id}_layout"
                separator=" "
            />
        </xpath>
    </template>

